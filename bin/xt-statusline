#!/usr/bin/env python3
"""Claude Code status line for xt agents: records the plan's usage windows for `xt status` (card #120).

Opt in from an agent's settings file (the human's):
  "statusLine": {"type": "command", "command": "/path/to/team/bin/xt-statusline"}
Claude Code passes its status JSON on stdin; this keeps the five-hour and seven-day readings in
<team root>/.xt/state/claude_plan.json and prints the model and both percentages. The team root is
XT_ROOT when set, else the xt checkout this script is in. Never fails: a bad input prints "xt"."""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

try:
    sys.path.insert(0, str(ROOT / "src"))
    from xt import planusage

    print(planusage.main(sys.stdin.read(), os.environ, ROOT))
except Exception:
    print("xt")
