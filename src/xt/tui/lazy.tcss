/* lazygit-style look: terminal colours, single thin frames with titles in the border,
   focus shown by frame colour and a reversed title, dense rows, no stock header/footer. */

Screen {
    background: ansi_default;
    color: ansi_default;
    layout: vertical;
    layers: base toast;
}

/* Three bands (card #162), fixed sizes: moving focus never shifts the layout; the focused pane shows
   only by colour. The app sets the heights and the Team pane's width for the terminal's; these are
   the sizes before it does. */
#top { height: 14; }  /* Team on the left, the Inbox on the right, the same height */
#team { width: 50%; }
#panel-1 { width: 1fr; }  /* Inbox */
#middle { height: 1fr; }  /* Work (2) or Flow (3), one at a time */
#detail { height: 6; }  /* Detail, full width at the bottom */

.panel {
    background: ansi_default;
    border: solid ansi_bright_black;
    border-title-color: ansi_default;
    border-title-style: none;
    border-subtitle-color: ansi_bright_black;
    padding: 0;
    margin: 0;
    height: 1fr;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

/* the focused panel: green frame and its title reversed (card #132) */
.panel:focus, .panel:focus-within {
    border: solid ansi_green;
    border-title-color: ansi_green;
    border-title-style: bold reverse;
}

/* Lists: one line per item, never wrapped (cut with …; the detail pane has the rest),
   plain highlight bar. */
OptionList {
    background: ansi_default;
    color: ansi_default;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

OptionList > .option-list--option {
    padding: 0;
}

/* Unfocused panels keep their selection visible but quiet; only the focused one gets the bar. */
OptionList > .option-list--option-highlighted {
    background: ansi_default;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: ansi_blue;
    color: ansi_bright_white;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: ansi_default;
}

#detail-body {
    background: ansi_default;
    padding: 0;
}

/* The last action's result: one line over the bottom frame, gone after about ten seconds. */
#toast {
    layer: toast;
    dock: bottom;
    offset: 1 -1;
    width: auto;
    max-width: 90%;
    height: 1;
    padding: 0 1;
    background: ansi_default;
    color: ansi_yellow;
    text-style: reverse;
}

#toast.fading {
    text-style: reverse dim;
}

#hints {
    height: 1;
    background: ansi_default;
    color: ansi_blue;
    padding: 0 1;
}

/* Popups: same thin frame, title in the border, no dimmed backdrop. */
ModalScreen {
    background: ansi_default 0%;
    align: center middle;
}

.popup {
    width: 60;
    height: auto;
    max-height: 80%;
    background: ansi_default;
    border: solid ansi_green;
    border-title-color: ansi_green;
    border-title-style: bold;
    border-subtitle-color: ansi_bright_black;
    padding: 0 1;
}

.popup.help {
    width: 84;
}

/* the supervisor's log on `v` (card #131): most of the screen, scrolls with j/k */
.popup.supervisor {
    width: 90%;
    max-width: 160;
    height: 80%;
    scrollbar-size-vertical: 1;
}

/* Flow's filter picker on `f` (card #130) */
.popup.pick {
    width: 70;
    max-width: 90%;
}

.popup.pick OptionList {
    height: auto;
    max-height: 20;
    border: none;
    padding: 0;
}

.popup Input {
    background: ansi_default;
    border: none;
    padding: 0;
    height: 1;
}

.popup Input:focus {
    border: none;
}

.popup.compose {
    width: 90%;
    max-width: 160;
    height: 70%;
    min-height: 12;
}

.compose-context {
    color: ansi_bright_black;
    height: auto;
    max-height: 35%;
    overflow-y: auto;
    margin: 0 0 1 0;
}

#compose-text {
    height: 1fr;
    min-height: 3;
    background: ansi_default;
    border: none;
    padding: 0;
}

/* a cursor in the text's own colour and a selection you can see, also in the ANSI colour mode */
#compose-text > .text-area--cursor {
    color: ansi_default;
    background: ansi_default;
    text-style: reverse;
}

#compose-text > .text-area--selection {
    background: ansi_blue;
    color: ansi_bright_white;
}

#compose-text > .text-area--cursor-line {
    background: ansi_default;
}

